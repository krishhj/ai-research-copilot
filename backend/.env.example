# This is an example .env file for the backend of the AI Research Copilot application.

# API
API_HOST=127.0.0.1
API_PORT=8000

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# LLM
GROQ_API_KEY=your_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
TEMPERATURE=0.2
MAX_TOKENS=1024

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]  #Change this to your frontend's URL if different. For example, if you are using a different port or domain, update it accordingly.

# Supabase Authentication
SUPABASE_URL=your-project-url
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
